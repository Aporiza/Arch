     .clk    (clk),
@@ -159,7 +191,7 @@ regfile u_rf (
 // 只有有效指令才能发起跳转；beq/bne 比较寄存器值，b/bl/jirl 无条件跳转
 assign br_taken = ((inst_beq & rj_eq_rd) |
                    (inst_bne & ~rj_eq_rd) |
-                   inst_jirl | inst_bl | inst_b) & if_id_valid;
+                   inst_jirl | inst_bl | inst_b) & if_id_valid & ready_go & resetn;
 assign br_target = (inst_beq | inst_bne | inst_bl | inst_b)
                  ? if_id_pc + br_offs
                  : rj_value + jirl_offs;
@@ -168,6 +200,9 @@ assign br_target = (inst_beq | inst_bne | inst_bl | inst_b)
 always @(posedge clk) begin
     if (reset)
         id_ex_valid <= 1'b0;
+    else if (!ready_go)
+        // 前端保持当前指令，后端继续前进；向 EX 注入一个无效槽。
+        id_ex_valid <= 1'b0;
     else begin
         id_ex_valid        <= if_id_valid;
         id_ex_pc           <= if_id_pc;

+                  | ({32{op_srl|op_sra}} & sr_result)
+                  | ({32{op_mul      }} & mul_result)
+                  | ({32{op_mulh     }} & mulh_result)
+                  | ({32{op_mulhu    }} & mulhu_result);
 
 endmodule

 assign ex_pending_we   = resetn && !flush && id_ex_valid && id_ex_gr_we &&
-                         (id_ex_res_from_mem || id_ex_csr_bus[81] ||
+                         (id_ex_res_from_mem || (|id_ex_csr_bus[83:81]) ||

diff --git "a/exp13\\myCPU/csr.v" "b/exp13\\myCPU/csr.v"
new file mode 100644
index 0000000..05921fe
--- /dev/null
+++ "b/exp13\\myCPU/csr.v"
@@ -0,0 +1,232 @@
+`include "csr_defs.vh"
+
+// 控制状态寄存器集中管理；指令访问和异常硬件更新均在 WB 提交。
+// 保留位读零且不可写，未实现地址读零、忽略写入。
+module csr (
+    input  wire        clk,
+    input  wire        resetn,
+    input  wire [7:0]  hw_int_in,
+    output wire        has_int,
+    output reg  [63:0] stable_counter,
+    input  wire [13:0] csr_num,
+    output reg  [31:0] csr_rdata,
+    input  wire        csr_we,
+    input  wire [31:0] csr_wmask,
+    input  wire [31:0] csr_wdata,
+    input  wire        wb_ex,
+    input  wire [31:0] wb_pc,
+    input  wire [5:0]  wb_ecode,
+    input  wire [8:0]  wb_esubcode,
+    input  wire [31:0] wb_badv,
+    input  wire        ertn_flush,
+    output wire [31:0] ex_entry,
+    output wire [31:0] ex_era
+);
+
+// 本阶段尚无 MMU/Cache：DA=1，PG/DATF/DATM=0；仅 PLV、IE 可写。
+reg [1:0] crmd_plv;
+reg       crmd_ie;
+reg [1:0] prmd_pplv;
+reg       prmd_pie;
+reg [1:0] estat_sw;
+reg [5:0] estat_ecode;
+reg [8:0] estat_esubcode;
+reg [31:0] era;
+reg [25:0] eentry_va;
+reg [31:0] save0, save1, save2, save3;
+
+wire [31:0] masked_value = (csr_wmask & csr_wdata) |
+                           (~csr_wmask & csr_rdata);
+assign ex_entry = {eentry_va, 6'b0};
+assign ex_era = era;
+
+reg [12:0] ecfg_lie;
+reg [7:0]  estat_hw;
+reg        estat_timer;
+reg [31:0] badv;
+reg [31:0] tid;
+reg        tcfg_en;
+reg        tcfg_periodic;
+reg [29:0] tcfg_initval;
+reg [31:0] timer_value;
+
+wire [12:0] interrupt_status = {1'b0, estat_timer, 1'b0, estat_hw, estat_sw};
+wire [31:0] tcfg_value = {tcfg_initval, tcfg_periodic, tcfg_en};
+wire        write_tcfg = csr_we && csr_num == `CSR_TCFG;
+assign has_int = crmd_ie && (|(ecfg_lie & interrupt_status));
+
+always @(*) begin
+    case (csr_num)
+        `CSR_CRMD:   csr_rdata = {28'b0, 1'b1, crmd_ie, crmd_plv};
+        `CSR_PRMD:   csr_rdata = {29'b0, prmd_pie, prmd_pplv};
+        `CSR_ESTAT:  csr_rdata = {1'b0, estat_esubcode, estat_ecode,
+                                3'b0, interrupt_status};
+        `CSR_ERA:    csr_rdata = era;
+        `CSR_EENTRY: csr_rdata = ex_entry;
+        `CSR_SAVE0:  csr_rdata = save0;
+        `CSR_SAVE1:  csr_rdata = save1;
+        `CSR_SAVE2:  csr_rdata = save2;
+        `CSR_SAVE3:  csr_rdata = save3;
+        `CSR_ECFG:   csr_rdata = {19'b0, ecfg_lie};
+        `CSR_BADV:   csr_rdata = badv;
+        `CSR_TID:    csr_rdata = tid;
+        `CSR_TCFG:   csr_rdata = tcfg_value;
+        `CSR_TVAL:   csr_rdata = timer_value;
+        `CSR_TICLR:  csr_rdata = 32'b0;
+        default:     csr_rdata = 32'b0;
+    endcase
+end
+
+// CRMD：异常入口保存前状态并关闭中断，ertn 恢复 PLV/IE。
+always @(posedge clk) begin
+    if (!resetn) begin
+        crmd_plv <= 2'b0;
+        crmd_ie <= 1'b0;
+    end else if (wb_ex) begin
+        crmd_plv <= 2'b0;
+        crmd_ie <= 1'b0;
+    end else if (ertn_flush) begin
+        crmd_plv <= prmd_pplv;
+        crmd_ie <= prmd_pie;
+    end else if (csr_we && csr_num == `CSR_CRMD) begin
+        crmd_plv <= masked_value[1:0];
+        crmd_ie <= masked_value[2];
+    end
+end
+
+// 稳定计数器不受流水线停顿影响，每个时钟周期递增一次。
+always @(posedge clk) begin
+    if (!resetn)
+        stable_counter <= 64'b0;
+    else
+        stable_counter <= stable_counter + 64'd1;
+end
+
+always @(posedge clk) begin
+    if (!resetn) begin
+        prmd_pplv <= 2'b0;
+        prmd_pie <= 1'b0;
+    end else if (wb_ex) begin
+        prmd_pplv <= crmd_plv;
+        prmd_pie <= crmd_ie;
+    end else if (csr_we && csr_num == `CSR_PRMD) begin
+        prmd_pplv <= masked_value[1:0];
+        prmd_pie <= masked_value[2];
+    end
+end
+
+// 软件中断位可写；异常编码由硬件更新，CSR 写不能修改。
+always @(posedge clk) begin
+    if (!resetn)
+        estat_sw <= 2'b0;
+    else if (csr_we && csr_num == `CSR_ESTAT)
+        estat_sw <= masked_value[1:0];
+end
+
+always @(posedge clk) begin
+    if (!resetn)
+        era <= 32'b0;
+    else if (wb_ex)
+        // 保存异常指令自身 PC；是否跳过该指令由处理程序决定。
+        era <= wb_pc;
+    else if (csr_we && csr_num == `CSR_ERA)
+        era <= masked_value;
+end
+
+always @(posedge clk) begin
+    if (!resetn)
+        eentry_va <= 26'b0;
+    else if (csr_we && csr_num == `CSR_EENTRY)
+        eentry_va <= masked_value[31:6];
+end
+
+always @(posedge clk) begin
+    if (!resetn) begin
+        save0 <= 32'b0;
+        save1 <= 32'b0;
+        save2 <= 32'b0;
+        save3 <= 32'b0;
+    end else if (csr_we) begin
+        case (csr_num)
+            `CSR_SAVE0: save0 <= masked_value;
+            `CSR_SAVE1: save1 <= masked_value;
+            `CSR_SAVE2: save2 <= masked_value;
+            `CSR_SAVE3: save3 <= masked_value;
+            default: begin end
+        endcase
+    end
+end
+
+always @(posedge clk) begin
+    if (!resetn) begin
+        estat_ecode <= 6'b0;
+        estat_esubcode <= 9'b0;
+    end else if (wb_ex) begin
+        estat_ecode <= wb_ecode;
+        estat_esubcode <= wb_esubcode;
+    end
+end
+
+// BADV 的硬件更新优先于软件写；非地址异常保持原值。
+always @(posedge clk) begin
+    if (!resetn)
+        badv <= 32'b0;
+    else if (wb_ex && ((wb_ecode == `ECODE_ADE && wb_esubcode == `ESUBCODE_ADEF) ||
+                       wb_ecode == `ECODE_ALE))
+        badv <= wb_badv;
+    else if (csr_we && csr_num == `CSR_BADV)
+        badv <= masked_value;
+end
+
+always @(posedge clk) begin
+    if (!resetn) begin
+        ecfg_lie <= 13'b0;
+        tid <= 32'b0;
+        estat_hw <= 8'b0;
+    end else begin
+        // 硬件中断在 CPU 时钟域采样；未实现的 IS[10]/IS[12] 恒零。
+        estat_hw <= hw_int_in;
+        if (csr_we && csr_num == `CSR_ECFG)
+            ecfg_lie <= masked_value[12:0] & 13'h1bff;
+        if (csr_we && csr_num == `CSR_TID)
+            tid <= masked_value;
+    end
+end
+
+// 配置字段与倒计数器分开维护。单次到期不清 En，TVAL 全 1 表示停止。
+always @(posedge clk) begin
+    if (!resetn) begin
+        tcfg_en <= 1'b0;
+        tcfg_periodic <= 1'b0;
+        tcfg_initval <= 30'b0;
+    end else if (write_tcfg) begin
+        tcfg_en <= masked_value[0];
+        tcfg_periodic <= masked_value[1];
+        tcfg_initval <= masked_value[31:2];
+    end
+end
+
+always @(posedge clk) begin
+    if (!resetn)
+        timer_value <= 32'hffff_ffff;
+    else if (write_tcfg && masked_value[0])
+        timer_value <= {masked_value[31:2], 2'b0};
+    else if (tcfg_en && timer_value != 32'hffff_ffff) begin
+        if (timer_value == 32'b0 && tcfg_periodic)
+            timer_value <= {tcfg_initval, 2'b0};
+        else
+            timer_value <= timer_value - 32'd1;
+    end
+end
+
+// 到期与 TICLR 写一清除同拍时到期优先；关闭定时器不清中断状态。
+always @(posedge clk) begin
+    if (!resetn)
+        estat_timer <= 1'b0;
+    else if (tcfg_en && timer_value == 32'b0)
+        estat_timer <= 1'b1;
+    else if (csr_we && csr_num == `CSR_TICLR && csr_wmask[0] && csr_wdata[0])
+        estat_timer <= 1'b0;
+end
+
+endmodule
diff --git "a/exp13\\myCPU/csr_defs.vh" "b/exp13\\myCPU/csr_defs.vh"
new file mode 100644
index 0000000..0f053fd
--- /dev/null
+++ "b/exp13\\myCPU/csr_defs.vh"
@@ -0,0 +1,46 @@
+// CSR 编号和异常标志集中定义，流水总线不再依赖散落的数字位号。
+`ifndef MYCPU_CSR_DEFS_VH
+`define MYCPU_CSR_DEFS_VH
+
+`define CSR_CRMD      14'h0000
+`define CSR_PRMD      14'h0001
+`define CSR_ECFG      14'h0004
+`define CSR_ESTAT     14'h0005
+`define CSR_ERA       14'h0006
+`define CSR_BADV      14'h0007
+`define CSR_EENTRY    14'h000c
+`define CSR_SAVE0     14'h0030
+`define CSR_SAVE1     14'h0031
+`define CSR_SAVE2     14'h0032
+`define CSR_SAVE3     14'h0033
+`define CSR_TID       14'h0040
+`define CSR_TCFG      14'h0041
+`define CSR_TVAL      14'h0042
+`define CSR_TICLR     14'h0044
+
+// {csr_re, csr_we, ertn, syscall, csr_num[13:0], wmask[31:0], wdata[31:0]}
+`define CSR_BUS_WD    82
+`define CSR_BUS_RE    81
+`define CSR_BUS_WE    80
+`define CSR_BUS_ERTN  79
+
+// 异常逐项携带到 WB，再按优先级编码；总线为 {flags[5:0], badv/pc}。
+`define EX_FLAGS_WD   6
+`define EX_BUS_WD     38
+`define EX_INT        5
+`define EX_ADEF       4
+`define EX_ALE        3
+`define EX_SYS        2
+`define EX_BRK        1
+`define EX_INE        0
+
+`define ECODE_INT     6'h00
+`define ECODE_ADE     6'h08
+`define ECODE_ALE     6'h09
+`define ECODE_SYS     6'h0b
+`define ECODE_BRK     6'h0c
+`define ECODE_INE     6'h0d
+`define ESUBCODE_ADEF 9'b0
+
+`endif
+
diff --git "a/exp11\\myCPU/ex_stage.v" "b/exp13\\myCPU/ex_stage.v"
index 8196e2f..9847943 100644
--- "a/exp11\\myCPU/ex_stage.v"
+++ "b/exp13\\myCPU/ex_stage.v"
@@ -4,6 +4,7 @@ module ex_stage (
     // 时钟与低有效同步复位
     input  wire         clk,
     input  wire         resetn,
+    input  wire         flush,
 
     // 来自 ID/EX 的操作数与控制信号
     input  wire         id_ex_valid,
@@ -20,12 +21,14 @@ module ex_stage (
     input  wire         id_ex_load_unsigned,
     input  wire         id_ex_gr_we,
     input  wire [4:0]   id_ex_dest,
+    input  wire [83:0]  id_ex_csr_bus,
+    input  wire [37:0]  id_ex_ex_bus,
 
     // 除法未完成时阻止 ID/EX 接收下一条指令。
     output wire         allow_in,
 
     // 当前 EX 指令的相关信息反馈给 ID。
-    // 算术/逻辑结果可直接前递；load 结果尚未返回，需要停顿。
+    // 算术/逻辑结果可直接前递；load 和 CSR 结果需等待 WB。
     output wire         ex_pending_we,
     output wire [4:0]   ex_pending_dest,
     output wire         ex_forward_we,
@@ -42,7 +45,9 @@ module ex_stage (
     output reg  [1:0]   ex_mem_mem_size,
     output reg          ex_mem_load_unsigned,
     output reg          ex_mem_gr_we,
-    output reg  [4:0]   ex_mem_dest
+    output reg  [4:0]   ex_mem_dest,
+    output reg  [83:0]  ex_mem_csr_bus,
+    output reg  [37:0]  ex_mem_ex_bus
 );
 // ALU 操作数选择：PC 或寄存器值，立即数或第二个寄存器值
 wire [31:0]  alu_result;
@@ -58,12 +63,18 @@ wire [31:0]  ex_result = is_div
 
 // complete 属于已启动的这条指令；不能让下一条除法消费旧完成标志。
 assign allow_in = !id_ex_valid || !is_div || (div_started && div_complete);
-assign ex_pending_we   = resetn && id_ex_valid && id_ex_gr_we &&
-                         (id_ex_res_from_mem || (is_div && !div_complete)) &&
+assign ex_pending_we   = resetn && !flush && id_ex_valid && id_ex_gr_we &&
+                         (id_ex_res_from_mem || id_ex_csr_bus[81] || id_ex_csr_bus[80] ||
+                          (is_div && !div_complete)) &&
                          (id_ex_dest != 5'd0);
 assign ex_pending_dest = id_ex_dest;
 wire [31:0]  alu_src1 = id_ex_src1_is_pc ? id_ex_pc : id_ex_rj_value;
 wire [31:0]  alu_src2 = id_ex_src2_is_imm ? id_ex_imm : id_ex_rkd_value;
+// 在发出数据 SRAM 请求之前检查地址对齐。字节访问始终对齐。
+wire ale = (id_ex_res_from_mem || id_ex_mem_we) &&
+           (((id_ex_mem_size == 2'b10) && (|alu_result[1:0])) ||
+            ((id_ex_mem_size == 2'b01) && alu_result[0]));
+wire ex_exception = (|id_ex_ex_bus[37:32]) || ale;
 
 alu u_alu (
     .alu_op     (id_ex_alu_op),
@@ -73,9 +84,10 @@ alu u_alu (
 );
 
 divider u_divider (
+    // 同步取消被异常冲刷的除法，避免旧 complete 污染处理程序中的除法。
     .clk       (clk),
-    .resetn    (resetn),
-    .start     (resetn && id_ex_valid && is_div && !div_started),
+    .resetn    (resetn && !flush),
+    .start     (resetn && !flush && id_ex_valid && is_div && !div_started),
     .is_signed (id_ex_alu_op[15] | id_ex_alu_op[16]),
     .dividend  (id_ex_rj_value),
     .divisor   (id_ex_rkd_value),
@@ -85,7 +97,7 @@ divider u_divider (
 );
 
 always @(posedge clk) begin
-    if (!resetn)
+    if (!resetn || flush)
         div_started <= 1'b0;
     else if (id_ex_valid && is_div && !div_started)
         div_started <= 1'b1;
@@ -93,8 +105,9 @@ always @(posedge clk) begin
         div_started <= 1'b0;
 end
 
-assign ex_forward_we   = resetn && id_ex_valid && id_ex_gr_we &&
-                         !id_ex_res_from_mem && allow_in &&
+assign ex_forward_we   = resetn && !flush && id_ex_valid && id_ex_gr_we &&
+                         !id_ex_res_from_mem && !id_ex_csr_bus[81] && !id_ex_csr_bus[80] &&
+                         !ex_exception && allow_in &&
                          (id_ex_dest != 5'd0);
 assign ex_forward_dest = id_ex_dest;
 assign ex_forward_data = ex_result;
@@ -102,19 +115,23 @@ assign ex_forward_data = ex_result;
 // EX/MEM：ALU 结果用于算术写回或访存地址。
 // store_data 直接传递第二个源寄存器值，不使用经过立即数选择的 alu_src2。
 always @(posedge clk) begin
-    if (~resetn)
+    if (~resetn || flush)
         ex_mem_valid <= 1'b0;
     else begin
         ex_mem_valid        <= id_ex_valid && allow_in;
         ex_mem_pc           <= id_ex_pc;
         ex_mem_alu_result   <= ex_result;
         ex_mem_store_data   <= id_ex_rkd_value;
-        ex_mem_res_from_mem <= id_ex_res_from_mem;
-        ex_mem_mem_we       <= id_ex_mem_we;
+        ex_mem_res_from_mem <= id_ex_res_from_mem && !ex_exception;
+        ex_mem_mem_we       <= id_ex_mem_we && !ex_exception;
         ex_mem_mem_size     <= id_ex_mem_size;
         ex_mem_load_unsigned <= id_ex_load_unsigned;
-        ex_mem_gr_we        <= id_ex_gr_we;
+        ex_mem_gr_we        <= id_ex_gr_we && !ex_exception;
         ex_mem_dest         <= id_ex_dest;
+        ex_mem_csr_bus      <= id_ex_csr_bus;
+        ex_mem_ex_bus       <= (|id_ex_ex_bus[37:32]) ? id_ex_ex_bus :
+                               {ale ? 6'b001000 : 6'b0,
+                                ale ? alu_result : id_ex_ex_bus[31:0]};
     end
 end
 
diff --git "a/exp11\\myCPU/id_stage.v" "b/exp13\\myCPU/id_stage.v"

                       (ex_mem_mem_size == 2'b01) ? (ex_mem_alu_result[1] ? 4'b1100 : 4'b0011) :
                                                    4'b1111;
@@ -80,7 +85,7 @@ assign mem_wb_mem_result = data_sram_rdata;
 // MEM/WB：传递 ALU 结果及对应的写回控制。
 // 复位清除有效位，WB 通过该有效位禁止无效指令写寄存器。

+// mul.w 的低 32 位对两种乘法相同；高位指令取对应乘积的高 32 位。
+wire [31:0] mul_result   = signed_product_66[31:0];
+wire [31:0] mulh_result  = signed_product_66[63:32];
+wire [31:0] mulhu_result = unsigned_product_66[63:32];
 

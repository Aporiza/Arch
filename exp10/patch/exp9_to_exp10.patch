+wire signed [32:0] signed_src1_33   = {alu_src1[31], alu_src1};
+wire signed [32:0] signed_src2_33   = {alu_src2[31], alu_src2};
+wire signed [32:0] unsigned_src1_33 = {1'b0, alu_src1};
+wire signed [32:0] unsigned_src2_33 = {1'b0, alu_src2};
